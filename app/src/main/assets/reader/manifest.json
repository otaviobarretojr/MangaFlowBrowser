{
  "manifest_version": 2,
  "name": "MangaFlow Reader",
  "version": "0.1.0",
  "description": "Integração local de leitura e filtros simples para o MangaFlow.",
  "browser_specific_settings": {
    "gecko": {
      "id": "reader@mangaflow.local"
    }
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": ["blocker.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["reader.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
