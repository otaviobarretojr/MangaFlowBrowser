{
  "manifest_version": 2,
  "name": "MangaFlow Reader",
  "version": "0.3.0",
  "description": "Leitor local com bloqueio de trackers e limpeza cosmética não destrutiva.",
  "browser_specific_settings": {
    "gecko": {
      "id": "reader@mangaflow.local"
    }
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": [
      "blocker.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ad-cleaner.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "reader.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
